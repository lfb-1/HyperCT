# @package azureml
# Copy this file to local.yaml and fill in your values
# local.yaml is gitignored and will override production.yaml
#
# Usage: python scripts/submit_job_hydra.py azureml=local

subscription_id: "your-subscription-id"
resource_group: "your-resource-group"
workspace_name: "your-workspace-name"
compute_name: "your-compute-cluster"
environment_name: "your-environment:version"
experiment_name: "your-experiment-name"

# Azure ML data paths
path_prefix: "azureml://datastores/workspaceworkingdirectory/paths"
data_base_path: "Users/your-username/data_weights"

# Input data paths
pretrain_weight_path: "pretrained/ctvit/"
train_val_path: "data/merged_with_notes/"
task_embed_path: "task_embeddings/"
dinov3_path: "pretrained/dinov3/"
checkpoint_path: "output/your-checkpoint-dir/"

# Output path template
output_path_template: "output/CT2ECHO_{model_type}_{timestamp}/"

# Job environment variables
job_env_vars:
  AZUREML_COMPUTE_USE_COMMON_RUNTIME: "True"
  AZUREML_COMMON_RUNTIME_USE_INTERACTIVE_CAPABILITY: "True"
  AZUREML_SSH_KEY: "generated-key"
  AZUREML_CONTAINER_RUNTIME_CONFIG: '{"shm_size": "32g"}'
